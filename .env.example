# Copy to .env and change the password:  cp .env.example .env
# .env is git-ignored. Only this example file is committed.

# --- Application ---
APP_PORT=8000
APP_VERSION=1.0.0
DOCKERHUB_USER=local

# --- PostgreSQL ---
POSTGRES_DB=cellstock
POSTGRES_USER=cellstock
POSTGRES_PASSWORD=change_me_please

# --- Connection targets (Compose SERVICE NAMES, not IPs or localhost) ---
DB_HOST=db
DB_PORT=5432
REDIS_HOST=cache
REDIS_PORT=6379

# --- Adminer (profile: tools) ---
ADMINER_PORT=8080
